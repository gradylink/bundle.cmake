include(${CMAKE_CURRENT_LIST_DIR}/utils.cmake)

set(_BUNDLE_TEMPLATES_DIR "${CMAKE_CURRENT_LIST_DIR}/../templates")

function(_bundle_generate_sources NAME OS PAK_FILE OUTPUT_DIR OUT_ASM_FILE OUT_C_FILE OUT_HEADER_FILE)
  file(MAKE_DIRECTORY "${OUTPUT_DIR}")

  if(OS STREQUAL "macos")
    set(TEMPLATE_FILE "${_BUNDLE_TEMPLATES_DIR}/incbin_macos.S.in")
    set(SYMBOL_PREFIX "_")
  elseif(OS STREQUAL "windows")
    set(TEMPLATE_FILE "${_BUNDLE_TEMPLATES_DIR}/incbin_windows.S.in")
    set(SYMBOL_PREFIX "")
  elseif(OS STREQUAL "wasm")
    set(TEMPLATE_FILE "${_BUNDLE_TEMPLATES_DIR}/incbin_wasm.S.in")
    set(SYMBOL_PREFIX "")
    file(SIZE "${PAK_FILE}" PAK_FILE_SIZE)
  else()
    set(TEMPLATE_FILE "${_BUNDLE_TEMPLATES_DIR}/incbin_unix.S.in")
    set(SYMBOL_PREFIX "")
  endif()

  file(READ "${TEMPLATE_FILE}" ASM_CONTENT)
  string(REPLACE "%%NAME%%" "${NAME}" ASM_CONTENT "${ASM_CONTENT}")
  string(REPLACE "%%PAK_FILE%%" "${PAK_FILE}" ASM_CONTENT "${ASM_CONTENT}")
  if(OS STREQUAL "wasm")
    string(REPLACE "%%PAK_SIZE%%" "${PAK_FILE_SIZE}" ASM_CONTENT "${ASM_CONTENT}")
  endif()

  set(ASM_FILE "${OUTPUT_DIR}/${NAME}_data.S")
  file(WRITE "${ASM_FILE}" "${ASM_CONTENT}")

  set(C_CONTENT "/* Generated by bundle.cmake. Do not edit by hand. */\n\n")
  string(APPEND C_CONTENT "#include \"bundle_runtime.h\"\n\n")
  string(APPEND C_CONTENT "extern const unsigned char ${SYMBOL_PREFIX}bundle_${NAME}_data[];\n")
  string(APPEND C_CONTENT "extern const unsigned char ${SYMBOL_PREFIX}bundle_${NAME}_data_end[];\n\n")
  string(APPEND C_CONTENT "bundle_archive bundle_${NAME}_archive(void) {\n")
  string(APPEND C_CONTENT "  bundle_archive archive;\n")
  string(APPEND C_CONTENT "  archive.data = bundle_${NAME}_data;\n")
  string(APPEND C_CONTENT "  archive.size = (size_t)(bundle_${NAME}_data_end - bundle_${NAME}_data);\n")
  string(APPEND C_CONTENT "  return archive;\n")
  string(APPEND C_CONTENT "}\n")

  set(C_FILE "${OUTPUT_DIR}/${NAME}_archive.c")
  file(WRITE "${C_FILE}" "${C_CONTENT}")

  string(TOUPPER "${NAME}" NAME_UPPER)
  set(H_CONTENT "/* Generated by bundle.cmake. Do not edit by hand. */\n\n")
  string(APPEND H_CONTENT "#ifndef BUNDLE_${NAME_UPPER}_H\n#define BUNDLE_${NAME_UPPER}_H\n\n")
  string(APPEND H_CONTENT "#include \"bundle_runtime.h\"\n\n")
  string(APPEND H_CONTENT "#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n")
  string(APPEND H_CONTENT "bundle_archive bundle_${NAME}_archive(void);\n\n")
  string(APPEND H_CONTENT "#ifdef __cplusplus\n}\n#endif\n\n")
  string(APPEND H_CONTENT "#endif /* BUNDLE_${NAME_UPPER}_H */\n")

  set(HEADER_FILE "${OUTPUT_DIR}/bundle_${NAME}.h")
  file(WRITE "${HEADER_FILE}" "${H_CONTENT}")

  set(${OUT_ASM_FILE} "${ASM_FILE}" PARENT_SCOPE)
  set(${OUT_C_FILE} "${C_FILE}" PARENT_SCOPE)
  set(${OUT_HEADER_FILE} "${HEADER_FILE}" PARENT_SCOPE)
endfunction()
